{
	"name": "svelte-portfolio",
	"version": "0.0.1",
	"private": true,
	"homepage": "http://fasteroid.github.io/svelte-portfolio",
	"scripts": {
		"dev": "bunx --bun vite",
		"build": "vite build",
		"preview": "vite preview",
		"predeploy": "bun run build",
		"deploy": "gh-pages -d build",
		"buildtree": "tsx ./src/building/treebuilder.ts",
		"buildscss": "tsx ./src/building/scssbase.ts",
		"prebuild": "bun run buildtree && bun run buildscss",
		"soundcloud": "cd ./src/lib/soundcloud & tsx getGraphData.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^3.0.0",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^3.0.0",
		"svelte": "^4.0.5",
		"svelte-check": "^3.4.3",
		"tslib": "^2.4.1",
		"tsx": "^3.14.0",
		"typescript": "^5.9.3",
		"vite": "^5.0.0"
	},
	"type": "module",
	"dependencies": {
		"@fasteroid/panzoom-revamped": "^11.0.0",
		"@sveltejs/adapter-static": "^3.0.0",
		"@types/d3": "^7.4.3",
		"colorthief": "^2.2.0",
		"d3": "^7.9.0",
		"panzoom": "^9.4.3",
		"sass": "1.32.13",
		"typescript-to-json-schema": "^0.6.1"
	}
}
